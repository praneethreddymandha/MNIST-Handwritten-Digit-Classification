    "import tensorflow as tf\n",
    "import numpy as np\n",
    "from tensorflow.keras.models import load_model, save_model\n",
    "from tkinter import *\n",
    "from PIL import Image, ImageDraw, ImageTk\n",
    "import os\n",
    "\n",
    "# Define the model file path\n",
    "model_file = '/Users/praneethreddy/Downloads/mnist_digit_classifier.keras'\n",
    "\n",
    "# Check if the model file exists\n",
    "if not os.path.exists(model_file):\n",
    "    # If the model file does not exist, create a dummy model and save it.\n",
    "    # This is a workaround for the error you encountered.  In a real\n",
    "    # application, you would have a pre-trained model saved as a .keras file.\n",
    "    print(\"Warning: Model file not found. Creating a dummy model.\")\n",
    "    model = tf.keras.Sequential([\n",
    "        tf.keras.layers.Flatten(input_shape=(28, 28)),\n",
    "        tf.keras.layers.Dense(10, activation='softmax')\n",
    "    ])\n",
    "    model.compile(optimizer='adam',\n",
    "                  loss='categorical_crossentropy',\n",
    "                  metrics=['accuracy'])\n",
    "    save_model(model, model_file)  # Save as a .keras file\n",
    "\n",
    "# Load the model\n",
    "model = load_model(model_file)\n",
    "\n",
    "# --- Tkinter Application Code ---\n",
    "class DigitDrawingApp:\n",
    "    def __init__(self, master):\n",
    "        self.master = master\n",
    "        master.title(\"Draw a Digit!\")\n",
    "\n",
    "        self.CANVAS_SIZE = 280\n",
    "        self.canvas = Canvas(master, width=self.CANVAS_SIZE, height=self.CANVAS_SIZE, bg='white')\n",
    "        self.canvas.pack(expand=YES, fill=BOTH)\n",
    "        self.canvas.bind(\"<B1-Motion>\", self.paint)  # Bind drawing to mouse drag\n",
    "\n",
    "        self.clear_button = Button(master, text=\"Clear\", command=self.clear_canvas)\n",
    "        self.clear_button.pack(side=LEFT)\n",
    "\n",
    "        self.predict_button = Button(master, text=\"Predict\", command=self.predict_digit)\n",
    "        self.predict_button.pack(side=LEFT)\n",
    "\n",
    "        self.label = Label(master, text=\"Prediction: \")\n",
    "        self.label.pack(side=LEFT)\n",
    "\n",
    "        self.image = Image.new(\"L\", (280, 280), color=0)  # Create a blank image for drawing\n",
    "        self.draw = ImageDraw.Draw(self.image)\n",
    "\n",
    "    def paint(self, event):\n",
    "        x1, y1 = (event.x - 10), (event.y - 10)\n",
    "        x2, y2 = (event.x + 10), (event.y + 10)\n",
    "        self.canvas.create_oval(x1, y1, x2, y2, fill=\"black\", outline=\"black\", width=20)\n",
    "        self.draw.ellipse((x1, y1, x2, y2), fill=255)  # Draw to PIL image\n",
    "\n",
    "    def clear_canvas(self):\n",
    "        self.canvas.delete(\"all\")\n",
    "        self.image = Image.new(\"L\", (280, 280), color=0)\n",
    "        self.draw = ImageDraw.Draw(self.image)\n",
    "\n",
    "    def predict_digit(self):\n",
    "        # Resize and preprocess the image\n",
    "        img = self.image.resize((28, 28)).convert('L')\n",
    "        img_array = np.array(img)\n",
    "        img_array = img_array.reshape(1, 28, 28, 1)  # Model expects a 4D tensor\n",
    "        img_array = img_array / 255.0  # Normalize\n",
    "    \n",
    "        # --- Add this code to display the image ---\n",
    "        import matplotlib.pyplot as plt\n",
    "        plt.imshow(img_array[0].reshape(28, 28), cmap='gray')\n",
    "        plt.title(\"Input to Model\")\n",
    "        plt.show()\n",
    "        # --- End of added code ---\n",
    "    \n",
    "        prediction = model.predict(img_array)\n",
    "        digit = np.argmax(prediction)\n",
    "        self.label.config(text=f\"Prediction: {digit}\")\n",
    "\n",
    "if __name__ == '__main__':\n",
    "    root = Tk()\n",
    "    app = DigitDrawingApp(root)\n",
    "    root.mainloop()"
   ]
